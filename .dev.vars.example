# Solo desarrollo local. La clave de prueba oficial de Turnstile siempre valida.
ANTHROPIC_API_KEY=""
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""
TEAM_WHATSAPP=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
TEAM_DOMAIN="https://your-team.cloudflareaccess.com"
POLICY_AUD=""
# KEK para cifrar tokens de subcuentas de Twilio en D1 (AES-256-GCM).
# Generar la real con: openssl rand -base64 32 — este valor es SOLO de ejemplo.
SECRETS_KEK="EJEMPLOEJEMPLOEJEMPLOEJEMPLOEJEMPLOEJEMPLOs="
# Vars (en producción viven en wrangler.toml [vars]; aquí se sobreescriben para dev).
# localhost:8080 = python3 -m http.server; añade el puerto que uses de verdad.
ALLOWED_WEB_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"
ADMIN_ORIGIN="http://localhost:8787"
LEAD_RETENTION_MONTHS="24"
# Tope diario de llamadas al modelo por tenant (la columna tenants.ai_daily_limit lo pisa).
AI_TENANT_DAILY_LIMIT="300"
# OAuth de Google Calendar (proyecto velai-calendar en Google Cloud Console).
# Redirect en dev: http://localhost:8787/oauth/calendar/callback (dado de alta allí).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
